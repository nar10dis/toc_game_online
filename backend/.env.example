# Copy to backend/.env and replace the values. Never commit backend/.env.
# Same user, password and database as the .env at the root; the host is the postgres service.
DATABASE_URL=postgresql://transcendence:change_me@postgres:5432/transcendence
# Two different long random strings, for example: openssl rand -hex 32
JWT_SECRET=change_me
JWT_REFRESH_SECRET=change_me_too
PORT=3001
